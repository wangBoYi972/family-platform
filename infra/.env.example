# 复制为 .env 并填写真实值。此文件不得提交到版本库（已在 .gitignore 中）。
# 生产密钥务必使用足够随机的值：JWT 至少 32 字节；档案密钥为 32 字节随机密钥的 Base64。

# 基础设施
MYSQL_ROOT_PASSWORD=change-me-strong
MYSQL_APP_PASSWORD=change-me-app
NACOS_AUTH_TOKEN=change-me-nacos-token
RABBITMQ_PASSWORD=change-me-rabbitmq
FAMILY_MESSAGING_ENABLED=true

# 应用安全
FAMILY_JWT_SECRET=replace-with-32-byte-random
# 生成 32 字节随机密钥的 Base64：openssl rand -base64 32
FAMILY_ARCHIVE_KEY=

# 限流（Gateway，需 Redis）
FAMILY_RATE_LIMIT_ENABLED=true
FAMILY_RATE_LIMIT_REPLENISH=20
FAMILY_RATE_LIMIT_BURST=40

# 文件存储：local（默认）或 s3（S3 兼容对象存储，如 MinIO/OSS/COS）
FAMILY_FILE_STORAGE_TYPE=local
FAMILY_S3_ENDPOINT=
FAMILY_S3_REGION=us-east-1
FAMILY_S3_BUCKET=
FAMILY_S3_ACCESS_KEY=
FAMILY_S3_SECRET_KEY=

# 监控
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# 首次初始化（生产 bootstrap，只在空库执行一次）
FAMILY_BOOTSTRAP_HOUSEHOLD_NAME=我的家庭
FAMILY_BOOTSTRAP_ADMIN_PHONE=
FAMILY_BOOTSTRAP_ADMIN_PASSWORD=
