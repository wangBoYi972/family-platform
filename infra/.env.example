# 复制为 .env 并填写真实值。此文件不得提交到版本库（已在 .gitignore 中）。
# 生产密钥务必使用足够随机的值：JWT 至少 32 字节；档案密钥为 32 字节随机密钥的 Base64。

# 基础设施
MYSQL_ROOT_PASSWORD=change-me-strong
MYSQL_APP_PASSWORD=change-me-app
NACOS_AUTH_TOKEN=change-me-nacos-token
RABBITMQ_PASSWORD=change-me-rabbitmq
FAMILY_MESSAGING_ENABLED=true

# 应用安全
FAMILY_JWT_SECRET=replace-with-32-byte-random
# 生成 32 字节随机密钥的 Base64：openssl rand -base64 32
FAMILY_ARCHIVE_KEY=

# 智能家居：设备访问令牌加密入库用的密钥，同样是 32 字节随机密钥的 Base64
# 留空时服务能启动，但保存/读取设备令牌会失败
FAMILY_IOT_ENCRYPTION_KEY=

# 限流（Gateway，需 Redis）
FAMILY_RATE_LIMIT_ENABLED=true
FAMILY_RATE_LIMIT_REPLENISH=20
FAMILY_RATE_LIMIT_BURST=40

# 文件存储：local（默认）或 s3（S3 兼容对象存储，如 MinIO/OSS/COS）
FAMILY_FILE_STORAGE_TYPE=local
FAMILY_S3_ENDPOINT=
FAMILY_S3_REGION=us-east-1
FAMILY_S3_BUCKET=
FAMILY_S3_ACCESS_KEY=
FAMILY_S3_SECRET_KEY=

# 监控告警
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# 告警通知走 Alertmanager Webhook（infra/prometheus/alertmanager.yml 里的 url）。
# 生产对接企业微信/钉钉群机器人：部署一个机器人中转网关，把 Alertmanager 的 JSON 转成机器人消息格式，
# 再把 alertmanager.yml 中的 url 改为 http://<网关>:<端口>/family-alert。
# 若改用邮件通知：在 alertmanager.yml 打开 smtp_* 与 email receiver，并把 route.receiver 改为 email。

# 实时通话（TURN）
# coturn 静态密钥：openssl rand -hex 32
FAMILY_TURN_SECRET=
# 客户端可达的 TURN/STUN 地址；公网部署改成域名或公网 IP，并确保 3478 与 49160-49200 已放行
FAMILY_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
FAMILY_STUN_URLS=stun:turn.example.com:3478
# TURN 凭据有效期（秒）
FAMILY_TURN_TTL_SECONDS=3600
# 单个通话最大人数（含发起者）；P2P 网状下建议不超过 8
FAMILY_MEDIA_MAX_PARTICIPANTS=8

# LiveKit SFU（8 人以上多人通话）
# 总开关：false=保持原 WebRTC mesh（上限 8 人）；验收通过后改 true 切到 SFU。
FAMILY_LIVEKIT_ENABLED=false
# 这两个值必须与 infra/livekit/livekit.yaml 的 keys 段完全一致；secret 至少 32 字节，用 openssl rand -hex 32 生成。
LIVEKIT_API_KEY=family-livekit
LIVEKIT_API_SECRET=change-me-livekit-api-secret-32bytes
# 客户端连接的 WSS 地址（经 Nginx/Caddy 终止 TLS 后的公网域名），如 wss://livekit.example.com
LIVEKIT_PUBLIC_URL=wss://livekit.example.com
# 服务端到 LiveKit 的内部地址（容器网络内）
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
# LiveKit 房间名前缀（实际房间名 = 前缀 + callId，避免与其它环境串房）
LIVEKIT_ROOM_PREFIX=family-
# JoinToken 有效期（秒），需覆盖单通通话时长
LIVEKIT_TOKEN_TTL_SECONDS=3600
# SFU 模式单通话人数上限（mesh 上限由上面的 FAMILY_MEDIA_MAX_PARTICIPANTS=8 控制，两者互不影响）
LIVEKIT_MAX_PARTICIPANTS=20
# Prometheus 抓取 LiveKit metrics 的宿主地址（host 网络）
LIVEKIT_METRICS_HOST=127.0.0.1

# 首次初始化（生产 bootstrap，只在空库执行一次）
FAMILY_BOOTSTRAP_HOUSEHOLD_NAME=我的家庭
FAMILY_BOOTSTRAP_ADMIN_PHONE=
FAMILY_BOOTSTRAP_ADMIN_PASSWORD=
