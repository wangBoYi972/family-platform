<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.familyhome.user.mapper.UserCredentialMapper">
    <!-- 显式写入 NULL，清除旧的锁定截止时间。 -->
    <update id="recordAttempt">
        UPDATE user_credential SET failed_attempts = #{attempts}, locked_until = #{until}
        WHERE phone = #{phone}
    </update>
</mapper>
